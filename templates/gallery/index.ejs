<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <title>peralta.sh - photography</title>
    <link rel="stylesheet" href="/gallery/main.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="/gallery/main.js"></script>
  </head>
  <body>
    <div id="menu-container">
      <div id="menu" class="transparent">
        <p><span>braddy peralta | </span>photography</p>
        <div>
          <button id="gallery-btn" class="active" onclick="openTab('gallery')">gallery</button>
          <button id="info-btn" onclick="openTab('info')">information</button>
        </div>
      </div>
    </div>

    <div id="gallery" class="shown">
      <div id="header-pic">
        <img src="<%= mainphoto %>">
        <div id="main-text">
          <div id="main-text-container">
            <h2><span>&#8643;</span> all works <span>&#8642;</span></h2>
            <div id="subheading">
              <h4>people</h4><h4>&</h4><h4>places</h4>
            </div>
          </div>
        </div>
      </div>

      <% photos.forEach(year => { %>
        <h2 class="year"><%= year.year %></h2>

        <div id="gallery-grid">
            <% year.albums.digital.forEach(photo => { %>
              <div class="entry">
                <img
                  src="<%= photo %>"
                  data-year="<%= year.year %>"
                  onclick="openPhoto(this)"
                >
              </div>
            <% }); %>

            <% year.albums.film.forEach(photo => { %>
              <div class="entry">
                <img
                  src="<%= photo %>"
                  data-year="<%= year.year %>"
                  onclick="openPhoto(this)"
                >
              </div>
            <% }); %>
        </div>
      <% }); %>
      
      <div id="gallery-toggle-container">
        <button id="gallery-toggle" type="button" aria-expanded="false">
          ↓ show all photos ↓
        </button>
      </div>

      <div class="social">
        <svg xmlns="http://www.w3.org/2000/svg" width="48px" height="48px" viewBox="0 0 42 42">
          <g transform="translate(5 5)">
            <g class="nc-icon-wrapper" fill="rgba(255, 255, 255, 1)">
              <path d="M10.202,2.098c-1.49,.07-2.507,.308-3.396,.657-.92,.359-1.7,.84-2.477,1.619-.776,.779-1.254,1.56-1.61,2.481-.345,.891-.578,1.909-.644,3.4-.066,1.49-.08,1.97-.073,5.771s.024,4.278,.096,5.772c.071,1.489,.308,2.506,.657,3.396,.359,.92,.84,1.7,1.619,2.477,.779,.776,1.559,1.253,2.483,1.61,.89,.344,1.909,.579,3.399,.644,1.49,.065,1.97,.08,5.771,.073,3.801-.007,4.279-.024,5.773-.095s2.505-.309,3.395-.657c.92-.36,1.701-.84,2.477-1.62s1.254-1.561,1.609-2.483c.345-.89,.579-1.909,.644-3.398,.065-1.494,.081-1.971,.073-5.773s-.024-4.278-.095-5.771-.308-2.507-.657-3.397c-.36-.92-.84-1.7-1.619-2.477s-1.561-1.254-2.483-1.609c-.891-.345-1.909-.58-3.399-.644s-1.97-.081-5.772-.074-4.278,.024-5.771,.096m.164,25.309c-1.365-.059-2.106-.286-2.6-.476-.654-.252-1.12-.557-1.612-1.044s-.795-.955-1.05-1.608c-.192-.494-.423-1.234-.487-2.599-.069-1.475-.084-1.918-.092-5.656s.006-4.18,.071-5.656c.058-1.364,.286-2.106,.476-2.6,.252-.655,.556-1.12,1.044-1.612s.955-.795,1.608-1.05c.493-.193,1.234-.422,2.598-.487,1.476-.07,1.919-.084,5.656-.092,3.737-.008,4.181,.006,5.658,.071,1.364,.059,2.106,.285,2.599,.476,.654,.252,1.12,.555,1.612,1.044s.795,.954,1.051,1.609c.193,.492,.422,1.232,.486,2.597,.07,1.476,.086,1.919,.093,5.656,.007,3.737-.006,4.181-.071,5.656-.06,1.365-.286,2.106-.476,2.601-.252,.654-.556,1.12-1.045,1.612s-.955,.795-1.608,1.05c-.493,.192-1.234,.422-2.597,.487-1.476,.069-1.919,.084-5.657,.092s-4.18-.007-5.656-.071M21.779,8.517c.002,.928,.755,1.679,1.683,1.677s1.679-.755,1.677-1.683c-.002-.928-.755-1.679-1.683-1.677,0,0,0,0,0,0-.928,.002-1.678,.755-1.677,1.683m-12.967,7.496c.008,3.97,3.232,7.182,7.202,7.174s7.183-3.232,7.176-7.202c-.008-3.97-3.233-7.183-7.203-7.175s-7.182,3.233-7.174,7.203m2.522-.005c-.005-2.577,2.08-4.671,4.658-4.676,2.577-.005,4.671,2.08,4.676,4.658,.005,2.577-2.08,4.671-4.658,4.676-2.577,.005-4.671-2.079-4.676-4.656h0"></path>
            </g>
          </g>
        </svg>
        <h3 id="instagram"><a href="https://www.instagram.com/wherethecultureis">@wherethecultureis</a></h3>
      </div>
    </div>

    <div id="info" class="hidden">
      <div>
        <div>
          <p class="info-subheading">camera gear</p>
          <p><span>&bull;</span> Fujifilm XT-5 <span>w/</span> 16-80mm f/4 lens <span>(digital)</span></p>
          <p><span>&bull;</span> Pentax K1000 <span>w/</span> 50mm lens <span>(film)</span></p>
        </div>
        <hr>
        <div class="bio">
          <p>I'm a hobbyist photographer based in NYC.<br><br>
          This website was <a href="https://github.com/brahdee/peralta.sh">made from scratch</a> & photos are uploaded in no particular order.<br><br>
          If you want to reach me for anything, you can<br><a href="mailto:braddy@peralta.sh">email me</a>.</p>
        </div>
      </div>
    </div>

    <p id="c">(c) braddy peralta <span>2026</span></p>

    <div id="photo-viewer">
      <div id="photo-container">
        <div id="photo-info">
          <span id="photo-name"></span>
          <span id="photo-year"></span>
        </div>
        <img id="viewer-image" src="" alt="">
      </div>
    </div>
  </body>
</html>