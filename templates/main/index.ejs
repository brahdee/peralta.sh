<!doctype html>
<html lang="en">
  <%- include('../header.ejs', { title: 'main' }) %>
  <body>
    <div id="main-container">
      <p id="header">
        <span>braddy peralta</span>
        <span id="separator">///</span>
        <span class="aqua">java, python, javascript, css, html</span>
      </p>
      <div id="main">
        <div id="inner">
          <p>
            Hi! I'm a <span id="age"><%= age %></span> year old computer science
            student, currently studying at
            <a href="https://ncsu.edu" id="uni"> NC State University</a>.
          </p>
          <p>
            I also do some photography in my free time, a gallery of which which
            <a href="/gallery" class="aqua">you can view over here ></a>
          </p>
          <p>
            Thank you for your curiosity! If you want to contact me, feel free
            to email me at:
          </p>
          <p>
            <a href="mailto:braddy@peralta.sh" class="aqua"
              >braddy@peralta.sh</a
            >
          </p>
          <div id="cat"></div>
          <p id="catinfo">my cat -></p>
        </div>
      </div>
      <div id="submenu">
        <p>It's currently <span id="clock">-:-- --</span> for me (EST)</p>
        <a href="https://github.com/brahdee" class="aqua">GitHub</a>
        <a href="https://linkedin.com/in/braddyp" class="aqua">LinkedIn</a>
        <a href="https://github.com/brahdee/peralta.sh">
          <img
            width="100px"
            alt="GitHub last commit"
            src="https://img.shields.io/github/last-commit/brahdee/peralta.sh?style=flat-square&labelColor=141417&color=1f2037"
            style="vertical-align: middle"
          />
        </a>
      </div>
      <div id="spotify" style="--album-color: <%= nowPlaying?.color %>">
        <p>
          <span class="darker">Currently listening to:</span><br />
          <a
            href="<%= nowPlaying?.url %>"
            target="_blank"
            class="aqua"
            id="song"
          >
            <%= nowPlaying?.name %>
          </a>
          <br /><span class="darker">by</span>
          <span id="artist"><%= nowPlaying?.artist %></span>
        </p>
        <img
          src="<%= nowPlaying?.image %>"
          id="album-art"
          alt="Album artwork"
        />
        <div id="bar"><div class="fill"></div></div>
      </div>
    </div>
  </body>
</html>
