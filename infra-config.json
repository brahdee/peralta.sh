{
  "$schema": "https://encore.dev/schemas/infra.schema.json",
  "secrets": {
    "r2AccessKey": {
      "$env": "R2_ACCESS_KEY"
    },
    "r2SecretKey": {
      "$env": "R2_SECRET_KEY"
    },
    "r2URL": {
      "$env": "R2_URL"
    },
    "spotifyClientID": {
      "$env": "SPOTIFY_CLIENT_ID"
    },
    "spotifyClientSecret": {
      "$env": "SPOTIFY_CLIENT_SECRET"
    },
    "spotifyRefreshToken": {
      "$env": "SPOTIFY_REFRESH_TOKEN"
    }
  }
}